# Server monitor (#182). Copy to monitor.env next to monitor.py, fill in every line, then: chmod 600 monitor.env
# The real monitor.env is never in git. Every line below must be there: the code has no defaults, and a missing
# line (or an empty value that isn't optional) stops the bot and says so on Telegram.
# One KEY=value per line; comments only on their own lines (a # after a value would become part of it).

# --- secrets

# Required. The bot's token, from @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Required. Who gets the messages: chat ids, comma-separated. Each person presses Start on the bot; getUpdates shows the id
TELEGRAM_CHAT_IDS=
# Required. hPanel -> Profile -> API
HOSTINGER_API_TOKEN=
# Required. GET /api/vps/v1/virtual-machines: the "id" of the VPS with your hostname
VPS_ID=

# --- messages

# Required. The name at the start of every message
NAME=
# Required. When the status message goes out, in TIMEZONE: times and ranges with a step in minutes, comma-separated.
# Use a colon and 5-minute marks (the bot runs every 5 minutes). Examples: 09:00   or   10:00, 17:00-19:00/15
STATUS_AT=
# Required. The time zone of STATUS_AT (an IANA name, e.g. Europe/London)
TIMEZONE=
# Required. Every message shows the time in these zones: label=zone, comma-separated; UTC needs no zone.
# Example: UTC,London=Europe/London,New York=America/New_York
SHOW_TIMES=

# --- check 1: the sites

# Required. Each must answer 200 within 10 seconds; comma-separated. Example: https://example.com,https://www.example.com
SITES=

# --- check 3: the nightly database dump

# Required. The folder of the nightly dumps and their log. Example: ~/backups
BACKUP_DIR=
# Required. Which files in BACKUP_DIR are the nightly dumps. Example: nightly-*.dump
BACKUP_GLOB=
# Required. The backup's log file in BACKUP_DIR; its last line must say "ok". Example: backup.log
BACKUP_LOG=
# Required. The newest dump must be at most this many hours old. Example: 26 (a daily backup plus some slack)
NIGHTLY_MAX_HOURS=
# Required. ... and above this size, in KB. Example: 100
NIGHTLY_MIN_KB=

# --- check 4: the provider's weekly backup

# Required. The newest weekly backup must be at most this many days old. Example: 8
WEEKLY_MAX_DAYS=

# --- GitHub, in the status message

# Optional: leave both empty for no GitHub lines. The repository (owner/name): its last CI run and latest release
GITHUB_REPO=
# Optional (empty together with GITHUB_REPO; required if GITHUB_REPO is set). The branch of "last CI run". Example: main
GITHUB_BRANCH=
