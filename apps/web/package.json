{
	"name": "web",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "vite --host :: --port 3000",
		"build": "node tools/generate-llms.js || true && vite build --outDir ../../dist/apps/web",
		"start": "vite preview --outDir ../../dist/apps/web --host :: --port 3000",
		"lint": "eslint . --quiet; lint_status=$?; eslint \"src/**/*.jsx\" --config eslint.config.mjs --format ./eslint.unicode-escapes-formatter.mjs --no-error-on-unmatched-pattern; exit $lint_status",
		"lint:warn": "eslint ."
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-helmet": "^6.1.0",
		"react-router-dom": "^7.18.2",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@babel/generator": "^7.26.3",
		"@babel/parser": "^7.26.3",
		"@babel/traverse": "^7.26.4",
		"@babel/types": "^7.26.3",
		"@types/node": "^20.17.10",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^5.2.0",
		"autoprefixer": "^10.4.20",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.1.0",
		"globals": "^15.14.0",
		"postcss": "^8.5.23",
		"tailwindcss": "^3.4.17",
		"terser": "^5.37.0",
		"vite": "^7.3.6"
	}
