# This is the URL for supabase API 
# default is http://127.0.0.1:54321
# run 'npx supabase status' to show yours
VITE_SUPABASE_URL=
# Publishable key. Maps to the `anon` Postgres role.
# Safe to ship in browser code: RLS decides what anon can do
# starts with sb_publishable_..
# run 'npx supabase status' to show yours
VITE_SUPABASE_PUBLISHABLE_KEY=