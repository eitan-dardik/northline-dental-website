# --- PostgreSQL (db service) ---
POSTGRES_DB=          # database name, e.g. umami
POSTGRES_USER=        # database user, e.g. umami
POSTGRES_PASSWORD=    # generate: openssl rand -hex 24   (hex = safe inside a URL)
#optional
#TWO_FACTOR_ENCRYPTION_KEY: #generate: openssl rand -hex 32

# --- Umami (umami service) ---
DATABASE_URL=         # postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

APP_SECRET=           #  random string used to secure authentication tokens. Each installation should have a unique value. generate: openssl rand -hex 32  (signs login sessions)