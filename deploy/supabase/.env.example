# =============================================================================
#  Northline -- self-hosted Supabase (trimmed stack), environment template
#  Only the variables deploy/supabase/docker-compose.yml uses. Every value is
#  empty on purpose: copy to .env ON THE SERVER, fill it in there, never commit
#  the real .env. Staging and production each get their OWN fresh values.
#  Generate keys first:  sh utils/generate-keys.sh --update-env
#                        sh utils/add-new-auth-keys.sh --update-env
# =============================================================================

# --- Project and host ports (differ per environment) -------------------------
# Compose project name; prefixes containers/volumes (northline-stage / northline-prod)
COMPOSE_PROJECT_NAME=
# Host port of the API gateway on 127.0.0.1 (staging 8000, production 8100)
API_GW_HTTP_PORT=
# Host port of Postgres on 127.0.0.1, for the SSH tunnel (staging 5432, production 5433)
DB_HOST_PORT=

# --- Database ----------------------------------------------------------------
# Database host inside the Compose network (the service name: db)
POSTGRES_HOST=
# Postgres port inside the container (5432)
POSTGRES_PORT=
# Database name (postgres)
POSTGRES_DB=
# Postgres password, used by every service; openssl rand -hex 24 (hex is URL-safe)
POSTGRES_PASSWORD=

# --- Legacy JWT keys (generate-keys.sh) --------------------------------------
# Symmetric HS256 secret that signs and verifies tokens; at least 32 characters
JWT_SECRET=
# Lifetime of issued tokens in seconds (e.g. 3600)
JWT_EXPIRY=
# Legacy anon API key (JWT) - maps requests to the anon role
ANON_KEY=
# Legacy service_role API key (JWT) - BYPASSES RLS, server only, never in a browser
SERVICE_ROLE_KEY=

# --- New API keys and signing keys (add-new-auth-keys.sh) ---------------------
# Publishable key (sb_publishable_...) - safe in the browser, maps to anon
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) - BYPASSES RLS, stays on this server only
SUPABASE_SECRET_KEY=
# Signing JWKs (private) used by Auth to issue tokens
JWT_KEYS=
# Public JWKS used by PostgREST to verify tokens
JWT_JWKS=
# ES256-signed anon key, used internally by the gateway only
ANON_KEY_ASYMMETRIC=
# ES256-signed service_role key, used internally by the gateway only
SERVICE_ROLE_KEY_ASYMMETRIC=

# --- Public URLs (per environment) --------------------------------------------
# Public HTTPS address of this stack's API (https://northline-api-stage.<your-domain>)
SUPABASE_PUBLIC_URL=
# Public URL of the Auth service (<SUPABASE_PUBLIC_URL>/auth/v1)
API_EXTERNAL_URL=
# The website this stack serves (https://northline-stage.<your-domain>)
SITE_URL=
# Extra allowed redirect URLs for Auth, comma-separated (Northline: empty)
ADDITIONAL_REDIRECT_URLS=

# --- Studio and dashboard ------------------------------------------------------
# Studio login username (not "supabase")
DASHBOARD_USERNAME=
# Studio login password; openssl rand -hex 24
DASHBOARD_PASSWORD=
# Key that encrypts connection strings between Studio and postgres-meta; openssl rand -base64 24
PG_META_CRYPTO_KEY=
# Organization name shown in Studio
STUDIO_DEFAULT_ORGANIZATION=
# Project name shown in Studio
STUDIO_DEFAULT_PROJECT=

# --- PostgREST (the REST API) ---------------------------------------------------
# Schemas exposed through /rest/v1 (public,graphql_public)
PGRST_DB_SCHEMAS=
# Maximum rows one request can return (default 1000)
PGRST_DB_MAX_ROWS=
# Extra schemas on every request's search_path (default public)
PGRST_DB_EXTRA_SEARCH_PATH=

# --- Auth (GoTrue) - Northline has no logins --------------------------------------
# Block new account signups (Northline: true)
DISABLE_SIGNUP=
# Allow signup with email (Northline: false)
ENABLE_EMAIL_SIGNUP=
# Skip email confirmation for new users (false)
ENABLE_EMAIL_AUTOCONFIRM=
# Allow anonymous sign-ins (false)
ENABLE_ANONYMOUS_USERS=
# Allow signup with phone (Northline: false)
ENABLE_PHONE_SIGNUP=
# Skip SMS confirmation for new users (false)
ENABLE_PHONE_AUTOCONFIRM=

# --- Auth email (SMTP) - unused while signups are off -----------------------------
# Admin/sender address for Auth emails
SMTP_ADMIN_EMAIL=
# SMTP server host
SMTP_HOST=
# SMTP server port
SMTP_PORT=
# SMTP username
SMTP_USER=
# SMTP password
SMTP_PASS=
# Sender display name in Auth emails
SMTP_SENDER_NAME=
# Link path in invite emails (/auth/v1/verify)
MAILER_URLPATHS_INVITE=
# Link path in confirmation emails (/auth/v1/verify)
MAILER_URLPATHS_CONFIRMATION=
# Link path in password-recovery emails (/auth/v1/verify)
MAILER_URLPATHS_RECOVERY=
# Link path in email-change emails (/auth/v1/verify)
MAILER_URLPATHS_EMAIL_CHANGE=