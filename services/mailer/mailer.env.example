# Mailer settings, per server: ~/northline/<stage|prod>/supabase/mailer.env (never committed).
# The clinic's name, phone and colors come from landing-template/config.json, mounted into the container.

# The stack's own gateway, over the Docker network (the same value on staging and production)
SUPABASE_URL=http://api-gw:8000
# That stack's sb_secret_... key, copied from its .env (server only, never in a browser)
SUPABASE_SECRET_KEY=

# Hostinger SMTP: smtp.hostinger.com, port 465 = SSL/TLS (587 = STARTTLS)
SMTP_HOST=
SMTP_PORT=
# The full mailbox address; also the sender
SMTP_USER=
SMTP_PASS=

# Where internal alerts go (in the sandbox, a mailbox you own)
MAIL_TO=